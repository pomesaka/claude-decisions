{
  "name": "claude-decisions",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "1.4.4",
    "miniflare": "5.20261023.1-beta",
    "prettier": "3.9.10",
    "wrangler": "4.154.0",
    "typescript": "5.9.3",
    "openai": "7.45.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "hono": "4.13.14",
    "ipaddr.js": "2.5.0",
    "zod": "4.6.7"
  },
  "scripts": {
    "dev": "bun --watch src/entrypoints/bun.ts",
    "start": "bun src/entrypoints/bun.ts",
    "test": "bun test",
    "typecheck": "bun run --bun tsc --noEmit",
    "contract:generate": "bun scripts/generate-openapi.ts",
    "worker:check": "bun run --bun wrangler deploy --dry-run",
    "format": "bun run --bun prettier --write src tests scripts package.json tsconfig.json wrangler.jsonc README.md",
    "format:check": "bun run --bun prettier --check src tests scripts package.json tsconfig.json wrangler.jsonc README.md",
    "worker:test": "bun test tests/worker.test.ts"
  },
  "packageManager": "bun@1.3.12",
  "engines": {
    "bun": ">=1.3.12"
  }
}
